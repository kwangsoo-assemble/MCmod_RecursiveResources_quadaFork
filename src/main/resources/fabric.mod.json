{
  "schemaVersion": 1,
  "id": "recursiveresources",
  "version": "${version}",

  "name": "Recursive Resources (quadaFork)",
  "description": "Enhances the Resource Pack menu by adding folder support for easier pack organization, ability to search packs by name or description, and new sorting options. quadaFork: Minecraft 1.21.8, Iris shader packs in sub-folders, overlay pack folder fix.",
  "icon": "assets/recursiveresources/icon.png",
  "authors": [
    "enjarai",
    "chylex"
  ],
  "contributors": [
    "kwangsoo (quadaFork)"
  ],
  "contact": {
    "homepage": "https://enjarai.dev",
    "sources": "https://github.com/kwangsoo-assemble/MCmod_RecursiveResources_quadaFork",
    "issues": "https://github.com/kwangsoo-assemble/MCmod_RecursiveResources_quadaFork/issues"
  },

  "license": "MPL-2.0",

  "environment": "client",
  "entrypoints": {
    "client": [
      "nl.enjarai.recursiveresources.RecursiveResources"
    ],
    "cicada": [
      "nl.enjarai.recursiveresources.RecursiveResources"
    ]
  },
  "mixins": [
    "recursiveresources.mixins.json",
    "recursiveresources.iris.mixins.json"
  ],
  "accessWidener": "recursiveresources.accesswidener",

  "depends": {
    "minecraft": ">=1.21.6",
    "fabric-api": "*",
    "cicada": ">=0.13.0 <1.0.0",
    "fabricloader": ">=0.15"
  },
  "suggests": {
    "iris": "*"
  },

  "custom": {
    "projects": {
      "modrinth": "CcL3MXyI",
      "curseforge": 674907
    }
  }
}
